{
  "name": "rich-the-garbage",
  "main": "worker/index.ts",
  "compatibility_date": "2025-12-17",
  "assets": {
    "directory": "./dist",
  },
  "kv_namespaces": [
    {
      "binding": "LIKES_KV",
      "id": "762cb910f4324abe9f1685b77efb0e88",
    },
    {
      "binding": "SCORE_KV",
      "id": "96ebd64b7ca84fadad4a54da461a60b9",
    },
    {
      "binding": "DONATIONS_KV",
      // TODO: Replace with your actual KV namespace ID
      // Run: wrangler kv:namespace create "DONATIONS_KV"
      "id": "YOUR_DONATIONS_KV_NAMESPACE_ID",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
